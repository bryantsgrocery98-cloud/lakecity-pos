{
  "name": "lakecity-pos",
  "version": "0.9.4",
  "description": "Free touch-first POS for a small convenience store",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --root .",
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node launch.mjs",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "serve": "tsx src/server/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "posUpdateSource": "https://raw.githubusercontent.com/bryantsgrocery98-cloud/lakecity-pos/updates/latest.json"
}
